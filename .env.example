# ==============================================================================
# LifeStyle App — Environment Configuration Template (.env.example)
# Phase P1: Backend Foundation
# 
# Security Note: Never commit real credentials or production secrets to Git.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# Database Configuration (PostgreSQL 16)
# Application runtime connects with least-privilege role: lifestyle_app
DATABASE_URL=postgresql://lifestyle_app:app_local_pass@localhost:5432/lifestyle_dev

# Migration tooling connects with DDL role: lifestyle_migrator
DATABASE_MIGRATION_URL=postgresql://lifestyle_migrator:migrator_local_pass@localhost:5432/lifestyle_dev

# Maintenance / purge worker connects with: lifestyle_maintenance
DATABASE_MAINTENANCE_URL=postgresql://lifestyle_maintenance:maintenance_local_pass@localhost:5432/lifestyle_dev

DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Temporary / Infrastructure Store (Redis 7)
REDIS_URL=redis://localhost:6379

# Authentication & Tokens
# Access Token (JWT HS256) — Secret must be >= 32 characters (256-bit minimum)
JWT_ACCESS_SECRET=local-dev-jwt-access-secret-at-least-32-chars-long
JWT_ACCESS_SECRET_PREVIOUS=
JWT_ISSUER=lifestyle-api
JWT_AUDIENCE=lifestyle-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
BCRYPT_COST=12

# Password Reset OTP Security (HMAC key >= 32 characters)
OTP_HMAC_SECRET=local-dev-otp-hmac-secret-at-least-32-chars-long

# CORS Hardening (Empty by default in MVP for native Flutter mobile client)
CORS_ALLOWED_ORIGINS=

# Email Infrastructure (Development default: Mailpit SMTP port 1025)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@lifestyle.app

# Push Notifications (FCM JSON credentials, optional in Phase P1)
FCM_CREDENTIALS=
