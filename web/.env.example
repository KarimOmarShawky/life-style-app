# =============================================================================
# LifeStyle Web Client — Environment Configuration Template (.env.example)
#
# Copy to `.env.local` (git-ignored) and adjust for your environment.
# Never commit real credentials or production secrets to Git.
# =============================================================================

# SERVER-ONLY backend origin used by the Next.js rewrite/proxy for
# `/api/v1/:path*`. This must NOT use a NEXT_PUBLIC_ prefix — the browser only
# ever calls same-origin relative `/api/v1/...` URLs.
#
# - Local development: the URL of the API server you started (see repo README).
# - Docker / deployment: the backend service DNS name or approved internal
#   address (example placeholder below).
# Production traffic to the backend must use HTTPS.
BACKEND_INTERNAL_URL=http://localhost:3000
