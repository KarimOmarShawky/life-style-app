{
  "name": "lifestyle-backend",
  "version": "1.0.1",
  "description": "LifeStyle App - PostgreSQL-backed REST API and worker service",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:up": "node-pg-migrate -m src/infrastructure/database/postgres/migrations -d DATABASE_MIGRATION_URL up",
    "migrate:down": "node-pg-migrate -m src/infrastructure/database/postgres/migrations -d DATABASE_MIGRATION_URL down",
    "migrate:create": "node-pg-migrate -m src/infrastructure/database/postgres/migrations create",
    "openapi:generate": "tsx src/docs/openapi-generator.ts",
    "openapi:check": "tsx src/docs/openapi-generator.ts",
    "check:forbidden": "node ../scripts/check-forbidden.mjs",
    "typecheck:tests": "tsc -p tsconfig.verification.json"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.12",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "kysely": "^0.28.17",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
