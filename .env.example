# ==============================================================================
# LifeStyle App — Environment Configuration Template (.env.example)
# Phase P1: Backend Foundation
# 
# Security Note: Never commit real credentials or production secrets to Git.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=3000
# Optional: comma-separated extra ports bound by the same API process (opt-in).
# When unset, only PORT is bound. Example: "3000,8080" binds both as auxiliary
# listeners (the port equal to PORT is skipped). See docs/deployment/
# environment-variables.md §4 for the AUD-17 migration note.
AUXILIARY_PORTS=
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# Fresh local setup: node scripts/local-setup.mjs --fresh-install (repository root).
# Use its ignored .local-setup/host.env; never overwrite an existing configuration.
# This template intentionally contains no passwords or usable signing-key defaults.
# Passwordless URIs below require separately provisioned credentials; copying this
# template alone is NOT a working setup. Do not weaken PostgreSQL authentication.
# Database Configuration (PostgreSQL 16)
# Application runtime connects with least-privilege role: lifestyle_app
DATABASE_URL=postgresql://lifestyle_app@localhost:5432/lifestyle_dev

# Migration tooling connects with DDL role: lifestyle_migrator
DATABASE_MIGRATION_URL=postgresql://lifestyle_migrator@localhost:5432/lifestyle_dev

# Maintenance / purge worker connects with: lifestyle_maintenance
DATABASE_MAINTENANCE_URL=postgresql://lifestyle_maintenance@localhost:5432/lifestyle_dev

DATABASE_POOL_MAX=10
# Per-statement safety ceiling (ms); raise for long exports/analytics.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL=false

# Temporary / Infrastructure Store (Redis 7)
REDIS_URL=redis://localhost:6379

# Authentication & Tokens
# Access Token (JWT HS256) — Secret must be >= 32 characters (256-bit minimum)
JWT_ACCESS_SECRET=
JWT_ACCESS_SECRET_PREVIOUS=
JWT_ISSUER=lifestyle-api
JWT_AUDIENCE=lifestyle-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
BCRYPT_COST=12

# Password Reset OTP Security (HMAC key >= 32 characters)
OTP_HMAC_SECRET=

# CORS Hardening (Empty by default in MVP for native Flutter mobile client)
CORS_ALLOWED_ORIGINS=

# Email Infrastructure (Development default: Mailpit SMTP port 1025)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@lifestyle.app

# Push Notifications (FCM JSON credentials, optional in Phase P1)
FCM_CREDENTIALS=
