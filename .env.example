# Copy to backend/.env and fill in. NEVER commit the real file.
# The application validates all of this at startup and refuses to run if
# anything required is missing or looks like a placeholder.

# --- Runtime --------------------------------------------------------------
NODE_ENV=development          # development | test | production
PORT=3000
API_PREFIX=/api/v1
SHUTDOWN_TIMEOUT_MS=15000     # grace period for in-flight requests

# --- PostgreSQL (REQUIRED) ------------------------------------------------
# Relational source of truth: users, tasks, habits, money, events, reminders.
# Use the DIRECT endpoint, not a transaction pooler: the migration runner takes
# a session-level advisory lock, which PgBouncer's transaction pooling breaks.
DATABASE_URL=postgresql://user:password@host:5432/lifestyle?sslmode=verify-full
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- MongoDB (optional in dev, REQUIRED in production) --------------------
# Notes and the audit log. Leave blank locally and both degrade gracefully.
MONGODB_URI=

# --- Redis (optional in dev, REQUIRED in production) ----------------------
# Cache, rate limiting, revoked-session denylist. Blank means per-process
# counters, which are wrong as soon as there is more than one instance.
REDIS_URL=
CACHE_DEFAULT_TTL_SECONDS=300

# --- Authentication (REQUIRED) --------------------------------------------
# Generate each separately:  openssl rand -base64 48
# They MUST differ. If they match, an access token would verify as a refresh
# token and a stolen 15-minute credential becomes a 30-day session.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=lifestyle-api
JWT_AUDIENCE=lifestyle-app
ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days

# bcrypt cost. Set from production performance testing; 12 is roughly 250ms.
BCRYPT_COST=12

# --- Cookies --------------------------------------------------------------
COOKIE_SECRET=
COOKIE_DOMAIN=
REFRESH_COOKIE_NAME=lifestyle_rt

# --- CORS (REQUIRED in production) ----------------------------------------
# Comma-separated explicit origins. Never a wildcard for an authenticated API.
CORS_ALLOWED_ORIGINS=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Account protection ---------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_SECONDS=900

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace
LOG_PRETTY=false              # true for human-readable local output
